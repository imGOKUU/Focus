<?xml version="1.0" encoding="utf-8"?>
<!--
  Meltide mark (melt + tide - time melting away, steadily): an ice cube in front of a low sun,
  a drip running off one corner and a drop falling - time melting away while
  you give it to something. Everything sits inside the adaptive-icon safe
  zone (a 66dp circle at the centre of the 108dp canvas).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sun, peeking out top right -->
    <path android:pathData="M68,35m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="68" android:startY="23" android:endX="68" android:endY="47">
                <item android:offset="0" android:color="#FFF7D2BC" />
                <item android:offset="1" android:color="#FFF0B99A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Drip running off the cube's lower edge (drawn first so the cube overlaps its root) -->
    <path android:pathData="M57.5,69.9Q59.8,69.9 60.2,72.6Q60.7,76.2 63,76.2Q65.3,76.2 65.3,73.4Q65.3,70.6 67,69.9Z" android:fillColor="#FFBDD7E3" />

    <!-- Ice cube body, lit from the top left -->
    <path android:pathData="M45,34H63Q72,34 72,43V61Q72,70 63,70H45Q36,70 36,61V43Q36,34 45,34Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="38" android:startY="36" android:endX="70" android:endY="70">
                <item android:offset="0" android:color="#FFF4FAFC" />
                <item android:offset="0.6" android:color="#FFDCEBF2" />
                <item android:offset="1" android:color="#FFB7D3E0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top face, a shade lighter - gives the cube its depth -->
    <path android:pathData="M45,34H63Q72,34 72,43V45.5Q64,41.5 54,41.5Q44,41.5 36,45.5V43Q36,34 45,34Z" android:fillColor="#A6FFFFFF" />

    <!-- Light catching the front edge -->
    <path android:pathData="M41,50V60" android:strokeWidth="3" android:strokeLineCap="round" android:strokeColor="#8CFFFFFF" />

    <!-- The falling drop -->
    <path android:pathData="M63,79.5Q65.6,82.4 65.6,84.1A2.6,2.6 0,0 1,60.4 84.1Q60.4,82.4 63,79.5Z" android:fillColor="#FFCFE4EE" />
</vector>
